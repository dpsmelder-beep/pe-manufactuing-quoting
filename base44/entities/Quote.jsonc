{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "title": "Quote Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_review",
        "quoted",
        "sent",
        "accepted",
        "rejected"
      ],
      "default": "new",
      "title": "Status"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_contact": {
      "type": "string",
      "title": "Customer Contact"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "customer_rfq_number": {
      "type": "string",
      "title": "Customer RFQ #"
    },
    "sales_rep_name": {
      "type": "string",
      "title": "Sales Rep"
    },
    "sales_terms": {
      "type": "string",
      "title": "Sales Terms"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "default": [],
      "title": "CAD Files"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": [],
      "title": "Line Items"
    },
    "notes": {
      "type": "string",
      "title": "General Note"
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "default": [],
      "title": "Review Notes"
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "title": "Subtotal"
    },
    "total": {
      "type": "number",
      "default": 0,
      "title": "Total"
    }
  },
  "required": [
    "customer_name"
  ]
}